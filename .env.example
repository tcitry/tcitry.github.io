# Local development only. Merge these into .env.local; do not overwrite the
# CONVEX_DEPLOYMENT / PUBLIC_CONVEX_URL values already generated by convex dev.
# All real values belong in ignored .env* files, never in this public example.

# Clerk development instance: use its pk_test_ publishable key.
PUBLIC_CLERK_PUBLISHABLE_KEY=

# Convex development Deployment URL, ending in .convex.cloud.
PUBLIC_CONVEX_URL=

# AI Search public endpoint, used by build scripts, the chat evaluation script
# and the Convex backend. Keep the actual hostname out of Git; set it in ignored
# .env.local for local builds, in Cloudflare Build variables for production
# builds, and in the matching Convex deployment as AI_SEARCH_PUBLIC_URL.
# Anonymous search now runs entirely on Pagefind and does not call this endpoint.
AI_SEARCH_PUBLIC_URL=

# Existing convex dev setup normally writes this to .env.local automatically.
# CONVEX_DEPLOYMENT=

# Production public values are in wrangler.jsonc vars. Optional ignored
# .env.production.local can override them for a local production build.
# Google One Tap is enabled only in PUBLIC_SITE_ENV=production builds with a
# pk_live_ key. Reuse the production Clerk Google connection with custom OAuth
# credentials; no Google Client Secret or additional key belongs in this file.

# CONVEX_DEPLOY_KEY is a Cloudflare Build secret. It is unnecessary for local
# frontend builds. For an explicit manual production release only, keep it in
# ignored .env.production.local; never put a production key in .env.local.
# CONVEX_DEPLOY_KEY=

# Authentication and Pro authorization do not require CLERK_SECRET_KEY.
# Convex reads Clerk Billing plans from verified v2 session claims.

# Sentry source-map upload. Set real values in ignored local env files or
# Cloudflare Build settings. The auth token is a build secret, never PUBLIC_.
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# SENTRY_RELEASE=

# Configure these in EACH matching Convex deployment, not PUBLIC_ variables.
# These comments are a checklist; local .env files do not set Convex cloud env.
# CLERK_FRONTEND_API_URL=
# CLERK_PRO_PLAN_SLUG=
# CONSULTATION_ADMIN_TOKEN_IDENTIFIER=
#
# CLERK_FRONTEND_API_URL is the instance's Frontend API URL and trusted JWT issuer.
# Enable Clerk's Convex integration; no separate JWT template is needed.
# CLERK_PRO_PLAN_SLUG must exactly match a verified pla plan containing user scope
# (u, ou or uo). Organization-only (o) and unknown scopes do not grant Pro access.
# Missing or invalid claims do not grant Pro access. Changes follow token refresh;
# JWT expiry is not the subscription end date.
# Production Convex must set this to the Clerk production Billing personal plan slug;
# omitting it cannot grant Pro and must not be treated as consultations being globally off.
# CONSULTATION_ADMIN_TOKEN_IDENTIFIER is the exact verified Clerk identity's
# tokenIdentifier (issuer + subject), never a display name or email.
# AI_SEARCH_PUBLIC_URL (also set in ignored .env files for local builds) must point
# to the same AI Search public endpoint in the Convex deployment. Convex Agent calls
# /chat/completions after authenticating the user. The model inherits the AI Search
# instance settings. Use the same configured hostname on both sides, including after
# a custom-domain change. The Gateway custom domain is not this Search endpoint.
# The development runtime passed real signed-in answer, citation and history
# recovery checks on 2026-09-10, including after removal of the old variables.
# Production configuration and deployment have not been changed in this round.
# It does not require BLOG_RETRIEVAL_URL, RAG_BRIDGE_SECRET,
# CLOUDFLARE_ACCOUNT_ID or CLOUDFLARE_API_TOKEN in Convex.
#
# Local/CI article-index synchronization and deployment still require their
# Cloudflare credentials. Keep these in the sync/release environment, not the
# browser or Convex runtime; do not remove existing CI/deployment credentials.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
