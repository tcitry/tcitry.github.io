# Local development only. Merge these into .env.local; do not overwrite the
# CONVEX_DEPLOYMENT / PUBLIC_CONVEX_URL values already generated by convex dev.
# All real values belong in ignored .env* files, never in this public example.

# Clerk development instance: use its pk_test_ publishable key.
PUBLIC_CLERK_PUBLISHABLE_KEY=

# Convex development Deployment URL, ending in .convex.cloud.
PUBLIC_CONVEX_URL=

# Existing convex dev setup normally writes this to .env.local automatically.
# CONVEX_DEPLOYMENT=

# Production public values are in wrangler.jsonc vars. Optional ignored
# .env.production.local can override them for a local production build.

# CONVEX_DEPLOY_KEY is a Cloudflare Build secret. It is unnecessary for local
# frontend builds. For an explicit manual production release only, keep it in
# ignored .env.production.local; never put a production key in .env.local.
# CONVEX_DEPLOY_KEY=

# This static client and the Worker do not use CLERK_SECRET_KEY.
# Clerk Billing uses it only in the Convex environment (see below).
# The Worker verifies Clerk session JWTs with the Frontend API issuer.
# For npm run dev, CLERK_JWT_ISSUER is derived from PUBLIC_CLERK_PUBLISHABLE_KEY.
# Production Worker runtime (dashboard or ignored .dev.vars) needs:
# CLERK_JWT_ISSUER=https://your-clerk-frontend-api-domain
# Optional networkless verify with the PEM public key from the Clerk API keys page:
# CLERK_JWT_KEY=

# Sentry source-map upload. Set real values in ignored local env files or
# Cloudflare Build settings. The auth token is a build secret, never PUBLIC_.
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# SENTRY_RELEASE=

# Configure these in EACH matching Convex deployment, not PUBLIC_ variables.
# These comments are a checklist; local .env files do not set Convex cloud env.
# CLERK_SECRET_KEY=
# CLERK_PRO_PLAN_SLUG=
# CONSULTATION_ADMIN_TOKEN_IDENTIFIER=
# BLOG_RETRIEVAL_URL=
# RAG_BRIDGE_SECRET=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
#
# CONSULTATION_ADMIN_TOKEN_IDENTIFIER is the exact verified Clerk identity's
# tokenIdentifier (issuer + subject), never a display name or email.
# BLOG_RETRIEVAL_URL is this Worker's /api/internal/retrieve endpoint.
# Use a long random RAG_BRIDGE_SECRET in both Convex and the Worker secrets.
# Cloudflare credentials in Convex need only the model-call permissions for the
# intended account; do not reuse a deployment/admin token for application calls.
# Existing gateway: tcitry-blog-chat. No extra Worker or Gateway is created.
