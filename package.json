{
  "name": "tcitry-blog-astro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "theme:verify": "node scripts/theme-package.mjs",
    "prepare:content": "node scripts/prepare-content.mjs && node scripts/export-ai-search.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare:content && npm run prepare:assets && astro dev --host 127.0.0.1",
    "build": "npm run prepare:content && npm run prepare:assets && node scripts/build-site.mjs",
    "build:production": "PUBLIC_SITE_ENV=production npm run build",
    "build:workers": "node scripts/workers-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check && npm run check:convex && npm run check:public",
    "test": "node --test tests/*.test.mjs && npm run test:reader",
    "test:browser": "node tests/browser/reading.mjs && node tests/browser/related-posts.mjs && node tests/browser/search-open.mjs && node tests/browser/search.mjs && node tests/browser/sidebar-tools.mjs && node tests/browser/convex-client-lifecycle.mjs && node tests/browser/service-boundary.mjs && node tests/browser/floating-scrollbars.mjs",
    "test:browser:sidebar": "node tests/browser/sidebar-tools.mjs",
    "test:browser:convex-lifecycle": "node tests/browser/convex-client-lifecycle.mjs",
    "test:browser:service-boundary": "node tests/browser/service-boundary.mjs",
    "test:browser:threejs": "node tests/browser/threejs-basics.mjs",
    "test:browser:timeline": "node tests/browser/timeline.mjs",
    "test:browser:sentry": "node tests/browser/sentry.mjs",
    "verify": "node scripts/verify-build.mjs",
    "verify:production": "PUBLIC_SITE_ENV=production npm run verify",
    "deploy": "npm run deploy:production",
    "deploy:production": "npm run build:production && npm run verify:release && npm run deploy:verified",
    "verify:release": "node scripts/verify-release.mjs",
    "deploy:verified": "node scripts/deploy-verified.mjs",
    "check:convex": "tsc --noEmit -p convex/tsconfig.json",
    "check:public": "node scripts/check-public-source.mjs",
    "test:reader": "vitest run --config vitest.reader.config.ts",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "check:production-config": "node scripts/reader-preflight.mjs",
    "test:browser:reader": "node tests/browser/reader.mjs",
    "test:browser:reader-ui": "node tests/browser/reader-ui.mjs",
    "test:browser:services": "node tests/browser/services.mjs",
    "check:local": "npm run check && npm test && npm run build && npm run verify",
    "ai-search:export": "node scripts/export-ai-search.mjs",
    "ai-search:sync": "node scripts/sync-ai-search.mjs",
    "ai-search:bootstrap": "node scripts/bootstrap-ai-search.mjs",
    "ai-search:set-model": "node scripts/set-ai-search-model.mjs",
    "ai-search:info": "node scripts/set-ai-search-model.mjs --info",
    "ai-chat:eval": "node scripts/eval-ai-chat.mjs",
    "ai-chat:eval:baseline": "node scripts/eval-ai-chat.mjs --baseline",
    "ai-chat:eval:quick": "node scripts/eval-ai-chat.mjs --baseline --sample 10 --delay 2000",
    "dev:worker": "wrangler dev"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.45",
    "@ai-sdk/provider": "4.0.11",
    "@ai-sdk/provider-utils": "5.0.37",
    "@astrojs/react": "6.0.5",
    "@astrojs/svelte": "9.0.1",
    "@clerk/react": "6.15.1",
    "@convex-dev/agent": "0.7.2",
    "@convex-dev/rate-limiter": "0.3.2",
    "@gravity-ui/icons": "2.22.0",
    "@heroui-pro/react": "1.0.0-beta.8",
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "@mdx-js/mdx": "3.1.1",
    "@react-aria/utils": "^3.34.1",
    "@sentry/astro": "10.73.0",
    "@tailwindcss/vite": "4.3.3",
    "@tcitry/astro-book": "0.1.1",
    "ai": "7.0.94",
    "astro": "7.3.1",
    "convex": "^1.45.0",
    "convex-helpers": "0.1.124",
    "jose": "^6.2.12",
    "marked": "18.0.0",
    "motion": "^13.2.0",
    "react": "19.2.8",
    "react-aria-components": "^1.21.1",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "^4.12.4",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "shiki": "4.4.3",
    "streamdown": "2.5.0",
    "svelte": "5.57.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "4.3.3",
    "three": "0.180.0",
    "tw-animate-css": "1.4.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@edge-runtime/vm": "5.0.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.2.0",
    "convex-test": "0.0.56",
    "parse5": "7.3.0",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "wrangler": "4.131.0"
  },
  "overrides": {
    "heroui-pro": {
      "tar": "7.5.22"
    }
  }
}
