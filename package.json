{
  "name": "tcitry-blog-astro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "theme:prepare": "node scripts/setup.mjs --theme-only",
    "prepare:content": "node scripts/prepare-content.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare:content && npm run prepare:assets && astro dev --host 127.0.0.1",
    "build": "npm run prepare:content && npm run prepare:assets && astro build && node scripts/finalize-build.mjs && pagefind --site dist --glob '{docs,posts,weekly}/**/*.html'",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify-build.mjs",
    "deploy:preview": "npm run build && npm run verify && wrangler deploy --config wrangler.preview.jsonc",
    "theme:sync": "node scripts/sync-theme.mjs"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@astrojs/svelte": "9.0.1",
    "@heroui-pro/react": "1.0.0-beta.8",
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "@react-aria/utils": "^3.34.1",
    "@tailwindcss/vite": "4.3.3",
    "@tcitry/astro-book": "file:.artifacts/tcitry-astro-book.tgz",
    "astro": "7.3.1",
    "motion": "^13.2.0",
    "react": "19.2.8",
    "react-aria-components": "^1.21.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.4",
    "svelte": "5.57.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "4.3.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "pagefind": "1.5.2",
    "typescript": "6.0.3",
    "wrangler": "4.129.0"
  },
  "overrides": {
    "heroui-pro": {
      "tar": "7.5.22"
    }
  }
}
