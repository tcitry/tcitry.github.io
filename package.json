{
  "name": "tcitry-blog-astro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "theme:prepare": "node scripts/setup.mjs --theme-only",
    "prepare:content": "node scripts/prepare-content.mjs && node scripts/export-ai-search.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare:content && npm run prepare:assets && astro dev --host 127.0.0.1",
    "build": "npm run prepare:content && npm run prepare:assets && astro build && node scripts/finalize-build.mjs",
    "build:production": "PUBLIC_SITE_ENV=production npm run build",
    "build:workers": "node scripts/workers-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser/reading.mjs && node tests/browser/related-posts.mjs && node tests/browser/search.mjs",
    "test:browser:threejs": "node tests/browser/threejs-basics.mjs",
    "verify": "node scripts/verify-build.mjs",
    "verify:production": "PUBLIC_SITE_ENV=production npm run verify",
    "deploy": "npm run deploy:production",
    "deploy:production": "npm run build:production && npm run verify:release && npm run deploy:verified",
    "theme:sync": "node scripts/sync-theme.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "deploy:verified": "node scripts/deploy-verified.mjs",
    "ai-search:export": "node scripts/export-ai-search.mjs",
    "ai-search:sync": "node scripts/sync-ai-search.mjs",
    "ai-search:bootstrap": "node scripts/bootstrap-ai-search.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs --env production && node scripts/verify-ai-search-deployment.mjs",
    "dev:worker": "wrangler dev",
    "test:browser:chat": "node tests/browser/chat.mjs"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@astrojs/svelte": "9.0.1",
    "@heroui-pro/react": "1.0.0-beta.8",
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "@react-aria/utils": "^3.34.1",
    "@tailwindcss/vite": "4.3.3",
    "@tcitry/astro-book": "file:.artifacts/tcitry-astro-book.tgz",
    "astro": "7.3.1",
    "marked": "18.0.0",
    "motion": "^13.2.0",
    "react": "19.2.8",
    "react-aria-components": "^1.21.1",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "^4.12.4",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.4.3",
    "streamdown": "2.5.0",
    "svelte": "5.57.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "4.3.3",
    "three": "0.180.0",
    "tw-animate-css": "1.4.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.2.0",
    "parse5": "7.3.0",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "wrangler": "4.129.0"
  },
  "overrides": {
    "heroui-pro": {
      "tar": "7.5.22"
    }
  }
}
