---
import BookLayout from '../layouts/BookLayout.astro';
import {content, createPage, navigation} from '../lib/site';

const page = createPage({
  id: '@site:reader', url: '/me/', title: '我的阅读',
  description: '收藏、阅读进度与仅自己可见的笔记。',
  type: 'reader', section: 'reader', toc: false,
});
---
<BookLayout page={page} navigation={navigation} tags={content.tags} categories={content.categories}>
  <article class="markdown book-article" data-pagefind-ignore>
    <h1>我的阅读</h1>
    <p>留住值得重读的文章，接着上次的位置读下去。</p>
    <button type="button" data-open-reading>打开右侧阅读面板</button>
    <noscript><p>请启用 JavaScript 使用阅读账户。公开文章始终可以直接阅读。</p></noscript>
  </article>
</BookLayout>

<script>
  document.querySelector('[data-open-reading]')?.addEventListener('click', () => {
    document.querySelector<HTMLButtonElement>('[data-chat-launcher]')?.click();
  });
</script>
