---
import BookLayout from '../layouts/BookLayout.astro';
import PageContent from '../components/book/PageContent.astro';
import PageToc from '../components/book/PageToc.astro';
import { content, navigation, buildViews } from '../lib/site';
import { getRelatedPosts, getRelatedPostsAnchor } from '../lib/related-posts';
import type { PageView } from '../lib/types';
import { parse } from 'yaml';
import portfolioSource from '../../data/portfolio.yaml?raw';
import { writeFileSync } from 'node:fs';
import type { MDXInstance } from 'astro';

const mdxModules = import.meta.glob<MDXInstance<Record<string, unknown>>>('../../.generated/mdx/*.mdx');

export function getStaticPaths() {
  const views = buildViews();
  writeFileSync('.generated/routes.json', JSON.stringify(views.map(({ page, entries }) => ({ url: page.url, kind: page.kind, type: page.type, id: page.id, entryIds: entries.map(entry => entry.id) }))));
  return views.map(view => ({
    params: { path: view.page.url === '/' ? undefined : decodeURI(view.page.url).replace(/^\/+|\/+$/g, '') },
    props: { view },
  }));
}
interface Props { view: PageView }
const { view } = Astro.props;
const mdxLoader = view.page.mdx ? mdxModules[`../../.generated/mdx/${view.page.mdx}`] : undefined;
if (view.page.mdx && !mdxLoader) throw new Error(`Missing compiled MDX module for ${view.page.source}; run prepare:content.`);
const mdx = mdxLoader ? await mdxLoader() : undefined;
const MdxContent = mdx?.Content;
if (mdx) view.page.headings = mdx.getHeadings();
const portfolio = parse(portfolioSource).items;
const common = {
  view, allPages: content.pages, tags: content.tags, categories: content.categories, portfolio,
  related: getRelatedPosts(view.page, content.pages), relatedAnchor: getRelatedPostsAnchor(view.page),
};
---
<BookLayout page={view.page} navigation={navigation} tags={content.tags} categories={content.categories}>
  {MdxContent ? <PageContent {...common}><MdxContent /></PageContent> : <PageContent {...common} />}
  <Fragment slot="toc"><PageToc {...common} /></Fragment>
</BookLayout>
