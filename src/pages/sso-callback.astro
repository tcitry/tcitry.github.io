---
import AuthCallbackLayout from '../layouts/AuthCallbackLayout.astro';
import SsoCallback from '../components/auth/SsoCallback';
// client:only: BlogClerkProvider reads window during render. client:load still
// SSRs the island during static prerender and crashes Workers Builds with
// "window is not defined". Google One Tap uses the same pattern.
---
<AuthCallbackLayout>
  <SsoCallback client:only="react">
    <p slot="fallback" role="status">Completing sign-in…</p>
  </SsoCallback>
  <noscript><p>JavaScript is required to complete sign-in. Enable it, then try again from the original page.</p></noscript>
</AuthCallbackLayout>
