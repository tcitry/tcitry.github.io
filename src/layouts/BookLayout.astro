---
import ThemeLayout from '@tcitry/astro-book/components/BookLayout';
import Giscus from '@tcitry/astro-book/components/Giscus';
import HeadingTree from '@tcitry/astro-book/components/HeadingTree';
import TermList from '@tcitry/astro-book/components/TermList';
import type { NavigationItem } from '@tcitry/astro-book/types';
import type { ContentPage, NavigationNode, TaxonomyTerm } from '../lib/types';
import { bookTitle, headTitle, dateText, flattenNavigation, includesPage, param } from '../components/book/helpers';
import '../styles/tailwind.css';
import blogStyles from '../styles/blog.module.css';
import codeStyles from '../components/code/BlogCode.module.css';
import BlogSearch from '../components/search/BlogSearch.astro';
import BlogChatWidget from '../components/chat/BlogChatWidget.astro';
import ObsidianNoteButton from '../components/book/ObsidianNoteButton';
interface Props { page: ContentPage; navigation: NavigationNode[]; tags: TaxonomyTerm[]; categories: TaxonomyTerm[] }
const { page, navigation, tags } = Astro.props;
const title = headTitle(page);
const canonical = new URL(page.url, 'https://yindongliang.com').href;
const production = import.meta.env.PUBLIC_SITE_ENV === 'production';
const description = page.description || page.summary.slice(0, 180) || "LYon's Blog offers insights on algorithms, coding, technology, and personal reflections. Explore tutorials, resources, and more.";
const tocHTML = Astro.slots.has('toc') ? await Astro.slots.render('toc') : '';
const docs = flattenNavigation(navigation);
const index = docs.findIndex((item) => item.id === page.id);
const pageLink = (item?: ContentPage) => item ? { title: bookTitle(item), url: item.url } : undefined;
const previous = index >= 0 ? pageLink(docs[index - 1]) : undefined;
const next = index >= 0 ? pageLink(docs[index + 1]) : undefined;
// Eligibility and pathname compatibility remain the blog's publishing policy.
const comments = page.kind === 'page' && ['docs', 'posts', 'about', 'weekly', 'links'].includes(page.type);
const readerArticle = page.kind === 'page' && ['docs', 'posts', 'weekly', 'links'].includes(page.type) && Boolean(page.html);
const articleSchema = page.kind === 'page' && page.type !== 'reader' ? {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: page.title,
  description, url: canonical, mainEntityOfPage: canonical,
  author: { '@type': 'Person', name: 'YINDONGLIANG', url: 'https://yindongliang.com/about/' },
  ...(dateText(page.date) ? { datePublished: page.date } : {}),
  ...(dateText(page.lastmod) ? { dateModified: page.lastmod } : {}),
  ...(page.image ? { image: new URL(page.image, 'https://yindongliang.com').href } : {}),
} : undefined;
const menu = [['/archives/', '✔️ Archives'], ['/tags/', '🏷️ Tags'], ['/weekly/', '🔥 Weekly'], ['/timeline/', '⏳ Timeline'], ['/links/', '🔗 Links'], ['/portfolio/', '📱 Portfolio'], ['/about/', '👨‍💻 About'], ['/labs/', '🧪 Labs']];
const toNavigation = (nodes: NavigationNode[]): NavigationItem[] => nodes
  .filter(({ page }) => !page.hidden && (page.kind !== 'page' || Boolean(page.html)))
  .map((node) => ({
    id: node.page.id, label: bookTitle(node.page),
    href: node.page.collapse && !node.page.html ? undefined : String(param(node.page, 'bookHref') || node.page.url),
    icon: param(node.page, 'bookIcon') ? `/book-icons/${param(node.page, 'bookIcon')}.svg` : undefined,
    active: node.page.id === page.id, expanded: includesPage(node, page.id),
    collapsible: node.page.collapse, flat: Boolean(param(node.page, 'bookFlatSection')),
    external: Boolean(param(node.page, 'bookHref')), children: toNavigation(node.children),
  }));
const site = {
  title: "LYon's Blog", home: '/', logo: '/logo.gif', favicon: '/favicon.png', lang: 'zh-CN',
  menu: [
    ...menu.map(([href, label]) => ({ id: href, href, label, active: page.url === href || (href === '/labs/' && page.url.startsWith(href)) })),
    { id: 'github', href: 'https://github.com/tcitry', label: 'Github', external: true },
    { id: 'rss', href: '/posts/index.xml', label: 'RSS', external: true },
  ],
};
---
<ThemeLayout site={site}
  components={{Search: BlogSearch}}
  code={false}
  page={{ title, url: page.url, headings: page.headings, toc: page.toc, bodyClass: `${blogStyles.site} ${codeStyles.scope} blog-chat-layout book-kind-${page.kind} book-type-${page.type}${page.layout ? ` book-layout-${page.layout}` : ''}` }}
  navigation={toNavigation(navigation)} previous={previous} next={next}
  seo={{ title, openGraphTitle: bookTitle(page), description, canonical, robots: production && page.type !== 'reader' ? undefined : 'noindex, nofollow', siteName: site.title, locale: 'zh_CN', type: page.kind === 'page' && page.type !== 'reader' ? 'article' : 'website', image: page.image ? new URL(page.image, 'https://yindongliang.com').href : undefined, twitterSite: '@tcitry', feeds: [{ title: site.title, href: '/index.xml' }], structuredData: articleSchema }}
  mermaid={{ errorMessage: '图表未能渲染，已保留 Mermaid 源码。' }}
  labels={{ skipToContent: '跳至正文', navigation: '主导航', openNavigation: '打开导航', closeNavigation: '关闭导航', tableOfContents: '目录', openTableOfContents: '打开目录', expandSection: '展开', previousPage: '上一篇', nextPage: '下一篇', search: '搜索博客', closeSearch: '关闭 Esc' }}>
  <Fragment slot="head">
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {production && <>
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-Q20952BPE6"></script>
      <script is:inline>window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'G-Q20952BPE6');</script>
      <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1305150098246428" crossorigin="anonymous"></script>
    </>}
    <slot name="head" />
  </Fragment>
  <slot />
  <Fragment slot="toc">
    {tocHTML ? <Fragment set:html={tocHTML} /> : page.headings.length ? <nav id="TableOfContents"><HeadingTree headings={page.headings} /></nav> : <nav><TermList title="Tags" total={tags.length} items={tags.map((term) => ({ label: term.name, href: term.url, count: term.pageIds.length }))} /></nav>}
  </Fragment>
  <Fragment slot="comments">
    {comments && <Giscus repo="tcitry/tcitry.github.io" repoId="MDEwOlJlcG9zaXRvcnkxNDc2MzI2MTk=" category="Announcements" categoryId="DIC_kwDOCMyx684COMlk" mapping="pathname" lang="zh-CN" theme="preferred_color_scheme" />}
  </Fragment>
  <Fragment slot="overlays">
    {import.meta.env.DEV && page.source && <ObsidianNoteButton source={page.source} client:load />}
    <BlogChatWidget pathname={readerArticle ? page.url : undefined} title={readerArticle ? bookTitle(page) : undefined} reading={page.type === 'reader'} />
    <script>import '../scripts/site'; import '../scripts/blog-code';</script>
  </Fragment>
</ThemeLayout>
