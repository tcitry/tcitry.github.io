---
interface Props {
  title?: string;
}
const title = Astro.props.title || '正在完成登录';
const canonical = 'https://yindongliang.com/sso-callback/';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <style is:global>
      body {
        font-family: system-ui, sans-serif;
        margin: 2rem auto;
        max-width: 40rem;
        padding: 0 1rem;
        line-height: 1.5;
      }
    </style>
  </head>
  <body data-pagefind-ignore>
    <main>
      <h1>{title}</h1>
      <slot />
    </main>
  </body>
</html>
