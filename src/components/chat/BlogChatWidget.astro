---
import '../../styles/chat-widget.css';
interface Props {pathname?: string; title?: string}
const {pathname, title} = Astro.props;
---
<div class="blog-chat-widget" data-blog-chat-widget data-chat-appearance="sidebar" data-reader-pathname={pathname} data-reader-title={title}>
  <div class="reader-selection-tools" data-selection-tools hidden role="group" aria-label="划词工具">
    <button type="button" data-selection-action="underline" aria-label="划线">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M5 2.75a.75.75 0 0 0-1.5 0V7a4.5 4.5 0 0 0 9 0V2.75a.75.75 0 0 0-1.5 0V7a3 3 0 0 1-6 0zm-.75 9.75a.75.75 0 0 0 0 1.5h7.5a.75.75 0 0 0 0-1.5z" clip-rule="evenodd"/></svg>
      <span class="blog-chat-widget__tooltip" aria-hidden="true">划线</span>
    </button>
    <button type="button" data-selection-action="highlight" aria-label="高亮">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M8.135.693A1.003 1.003 0 0 1 9.567.486l.091.082 5.559 5.559c.39.39.39 1.025 0 1.416l-4.332 4.332a2.003 2.003 0 0 1-2.833 0l-.383-.383c-.11-.11-.295-.084-.391.038l-2.391 3.01a2.467 2.467 0 1 1-3.464-3.464l3.014-2.389c.122-.096.148-.28.038-.39l-.312-.311a2.004 2.004 0 0 1 .001-2.834L6.917 2.4a6 6 0 0 0 1.031-1.378l.123-.224zM5.227 6.215a.5.5 0 0 0-.001.708l.311.313c.86.86.525 2.08-.167 2.629l-3.013 2.389a.963.963 0 1 0 1.353 1.352l2.39-3.01h.002c.555-.698 1.776-1.02 2.63-.167l.382.383a.5.5 0 0 0 .708 0l.416-.416L5.64 5.8zm3.835-4.12c-.307.497-.67.956-1.082 1.368L6.703 4.738 11.3 9.335l2.502-2.5-.759-.76-1.067 1.082a.405.405 0 0 1-.68-.384l.493-1.951z" clip-rule="evenodd"/></svg>
      <span class="blog-chat-widget__tooltip" aria-hidden="true">高亮</span>
    </button>
    <button type="button" data-selection-action="note" aria-label="写笔记">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M11.423 1A3.577 3.577 0 0 1 15 4.577c0 .27-.108.53-.3.722l-.528.529-1.971 1.971-5.059 5.059a3 3 0 0 1-1.533.82l-2.638.528a1 1 0 0 1-1.177-1.177l.528-2.638a3 3 0 0 1 .82-1.533l5.059-5.059 2.5-2.5c.191-.191.451-.299.722-.299m-2.31 4.009-4.91 4.91a1.5 1.5 0 0 0-.41.766l-.38 1.903 1.902-.38a1.5 1.5 0 0 0 .767-.41l4.91-4.91a2.08 2.08 0 0 0-1.88-1.88m3.098.658a3.6 3.6 0 0 0-1.878-1.879l1.28-1.28c.995.09 1.788.884 1.878 1.88z" clip-rule="evenodd"/></svg>
      <span class="blog-chat-widget__tooltip" aria-hidden="true">写笔记</span>
    </button>
  </div>
  <p class="reader-selection-tools__status" data-selection-status role="status"></p>
  <button class="blog-chat-widget__launcher" type="button" aria-label="打开博客助手" aria-haspopup="dialog" aria-expanded="false" aria-controls="blog-chat-panel" data-chat-launcher hidden>
    <span data-chat-launcher-icon>
      <svg viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 4h12a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H9l-6 3V7a3 3 0 0 1 3-3Z" />
        <path d="M8 9.5h8M8 13.5h5" />
      </svg>
    </span>
    <span data-chat-launcher-face></span>
    <span class="blog-chat-widget__tooltip" aria-hidden="true">博客助手</span>
  </button>
  <button class="blog-chat-widget__expand" type="button" aria-label="展开博客助手" aria-haspopup="dialog" aria-expanded="false" aria-controls="blog-chat-panel" data-chat-expand hidden>
    <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12.5 5-5 5 5 5" /></svg>
    <span class="blog-chat-widget__tooltip" aria-hidden="true">展开侧栏</span>
  </button>
  <dialog id="blog-chat-panel" class="blog-chat-widget__panel" aria-label="博客助手" data-chat-loaded="false">
    <template data-chat-load-template>
      <div class="blog-chat-widget__loading-header">
        <strong>博客助手</strong>
        <button type="button" class="blog-chat-widget__close" aria-label="关闭博客助手" data-chat-close><svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7.5 5 5 5-5 5" /></svg></button>
      </div>
      <div class="blog-chat-widget__loading">
        <p role="status" data-chat-load-status>正在打开博客助手…</p>
        <p data-chat-load-detail hidden></p>
        <button type="button" data-chat-retry hidden>重新加载</button>
        <button type="button" data-chat-refresh hidden>刷新页面</button>
      </div>
    </template>
    <div class="blog-chat-widget__mount" data-chat-mount>
      <div class="blog-chat-widget__loading-header">
        <strong>博客助手</strong>
        <button type="button" class="blog-chat-widget__close" aria-label="关闭博客助手" data-chat-close><svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7.5 5 5 5-5 5" /></svg></button>
      </div>
      <div class="blog-chat-widget__loading">
        <p role="status" data-chat-load-status>正在打开博客助手…</p>
        <p data-chat-load-detail hidden></p>
        <button type="button" data-chat-retry hidden>重新加载</button>
        <button type="button" data-chat-refresh hidden>刷新页面</button>
      </div>
    </div>
  </dialog>
</div>
<script>import '../../scripts/blog-chat';</script>
