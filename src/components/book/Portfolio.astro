---
import type { PortfolioItem } from './special-pages';
import PortfolioView from './PortfolioView';
interface Props { items: PortfolioItem[]; }
const { items } = Astro.props;
---
<PortfolioView items={items} />
<script>
  document.querySelectorAll<HTMLElement>('[data-content-collection="portfolio"]').forEach((collection) => {
    const select = collection.querySelector<HTMLSelectElement>('[data-portfolio-filter]');
    const projects = Array.from(collection.querySelectorAll<HTMLElement>('[data-portfolio-tags]'));
    const count = collection.querySelector<HTMLElement>('[data-portfolio-count]');
    const clear = collection.querySelector<HTMLButtonElement>('[data-portfolio-clear]');
    const clearWrapper = collection.querySelector<HTMLElement>('[data-portfolio-clear-wrapper]');
    if (!select || !count || !clear || !clearWrapper) return;

    const filter = () => {
      let visible = 0;
      projects.forEach((project) => {
        const tags: string[] = JSON.parse(project.dataset.portfolioTags || '[]');
        project.hidden = !!select.value && !tags.includes(select.value);
        if (!project.hidden) visible += 1;
      });
      count.textContent = `显示 ${visible} / ${projects.length} 个项目`;
      clearWrapper.hidden = !select.value;
    };
    select.addEventListener('change', filter);
    clear.addEventListener('click', () => { select.value = ''; filter(); select.focus(); });
    filter();
  });
</script>
