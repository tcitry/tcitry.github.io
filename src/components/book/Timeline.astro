---
import TimelineView, {type TimelineViewProps} from './TimelineView';
interface Props extends TimelineViewProps {}
---
<TimelineView {...Astro.props} />
<script>
  document.querySelectorAll<HTMLSelectElement>('[data-timeline-year-select]').forEach((select) => {
    select.addEventListener('change', () => {
      const destination = new URL(select.value, location.href);
      if (destination.origin === location.origin) location.assign(destination.href);
    });
  });
</script>
