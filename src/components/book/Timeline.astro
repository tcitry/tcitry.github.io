---
import type { TimelineItem } from './special-pages';
import styles from './Timeline.module.css';
interface Props { items: TimelineItem[]; }
const { items } = Astro.props;
---
<div class="timeline-container max-w-[1200px]"><div class:list={['timeline', styles.timeline]}>{items.map((item) =>
  <div class:list={['timeline-item', styles.item]} id={item.id}>
    <div class:list={['timeline-date', styles.date]}>{item.label}</div>
    <div class:list={['timeline-content', styles.content]} set:html={item.html} />
  </div>
)}</div></div>
