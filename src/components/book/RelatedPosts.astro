---
import type { ContentPage } from '../../lib/types';
import { getRelatedPostPreview } from '../../lib/related-post-preview';
import RelatedPostsCards from './RelatedPostsCards';
import contentStyles from './ContentSections.module.css';
import styles from './RelatedPosts.module.css';

interface Props {
  items: ContentPage[];
  anchorId: string;
  current: ContentPage;
}

const { items, anchorId, current } = Astro.props;
const headingId = `${anchorId}-heading`;
const cards = items.map((item) => getRelatedPostPreview(item, current));
---

{items.length > 0 && (
  <section
    id={anchorId}
    class:list={[contentStyles.section, styles.related]}
    data-related-posts
    data-pagefind-ignore
    aria-labelledby={headingId}
  >
    <h2 id={headingId} class={styles.heading}>相关阅读</h2>
    <RelatedPostsCards cards={cards} anchorId={anchorId} />
  </section>
)}
