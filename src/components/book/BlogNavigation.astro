---
import NavigationTree from '@tcitry/astro-book/components/NavigationTree';
import type { NavigationItem } from '@tcitry/astro-book/types';

interface Props { items: NavigationItem[]; expandLabel?: string; idPrefix?: string }
---

<NavigationTree {...Astro.props} />
{Astro.props.idPrefix === 'book-menu' && <div class="mt-2 mb-3">
  <label for="reading-theme" class="sr-only">阅读主题</label>
  <select id="reading-theme" data-book-theme-select aria-label="阅读主题" class="w-auto max-w-full appearance-auto rounded-lg border border-[var(--gray-200)] bg-[var(--body-background)] px-3 py-1.5 text-sm text-[var(--body-font-color)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-link)]">
    <option value="auto">跟随系统</option>
    <option value="light">浅色</option>
    <option value="dark">深色</option>
  </select>
</div>}
