---
import NavigationTree from '@tcitry/astro-book/components/NavigationTree';
import type { NavigationItem } from '@tcitry/astro-book/types';

interface Props { items: NavigationItem[]; expandLabel?: string; idPrefix?: string }
---

<NavigationTree {...Astro.props} />
{Astro.props.idPrefix === 'book-menu' && <div class="mt-3 mb-4 flex items-center gap-3">
  <label for="reading-theme" class="shrink-0">外观</label>
  <select id="reading-theme" data-book-theme-select aria-label="阅读主题" class="min-h-11 min-w-0 flex-1 rounded-lg border border-[var(--gray-200)] bg-[var(--body-background)] px-2 py-2 text-sm text-[var(--body-font-color)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-link)]">
    <option value="auto">跟随系统</option>
    <option value="light">浅色</option>
    <option value="dark">深色</option>
  </select>
</div>}
