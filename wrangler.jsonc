{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tcitry-blog",
  "main": "worker/index.ts",
  "account_id": "204c96c4c30f2f25afd657495d67fe4d",
  "compatibility_date": "2026-09-07",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "workers_dev": true,
  "routes": [{ "pattern": "yindongliang.com", "custom_domain": true }],
  "ai": { "binding": "AI", "remote": true },
  "ai_search": [{ "binding": "BLOG_SEARCH", "instance_name": "tcitry-blog-search", "remote": true }],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
